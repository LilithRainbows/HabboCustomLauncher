<Window x:Class="HabboCustomLauncher.LoadingWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabboCustomLauncher"
        x:Name="Window"
        mc:Ignorable="d" Width="600" Height="150" CanResize="False" SystemDecorations="BorderOnly" Opacity="1"
        Title="HabboCustomLauncher"
        WindowStartupLocation="CenterScreen" Background="#42062E" FontFamily="{StaticResource NewSegoeUI}" Icon="/Assets/HabboCustomLauncherIcon.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="32"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Label Grid.Row="0" Background="#A22A60" Foreground="White" Content="    HabboCustomLauncher" VerticalContentAlignment="Center"/>
    <local:CustomButton x:Name="CloseButton" IsFocusable="False" Grid.Row="0" Foreground="White" HorizontalAlignment="Right" Text="   X   " BackColor="#78FF0000"/>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Background="#1A000000">
        <Image x:Name="DollChair" Source="/Assets/DollChair.png" HorizontalAlignment="Left" Margin="10,10" RenderTransformOrigin="0.5,0.5">
          <Image.RenderTransform>
            <RotateTransform Angle="0"/>
          </Image.RenderTransform>
        </Image>
      </Grid>
      <TextBlock x:Name="StatusLabel" Margin="15" Text="Unknown status!" TextTrimming="CharacterEllipsis" Foreground="White" FontSize="30" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>