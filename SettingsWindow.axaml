<Window x:Class="HabboCustomLauncher.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HabboCustomLauncher"
        x:Name="Window"
        mc:Ignorable="d" Width="500" Height="260" CanResize="False" SystemDecorations="BorderOnly" Opacity="1"
        Title="HabboCustomLauncher"
        WindowStartupLocation="CenterScreen" Background="Black" FontFamily="{StaticResource NewSegoeUI}" Icon="/Assets/HabboCustomLauncherIcon.ico" ShowInTaskbar="False">
	<Grid>
		<Canvas ClipToBounds="true">
			<Image Source="/Assets/modal-backdrop-pink.png" Canvas.Left="-300" Canvas.Top="-100" Stretch="Uniform"/>
		</Canvas>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="32"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<Label Name="TitleBarLabel" Grid.Row="0" Background="#A22A60" Foreground="White" Content="    Settings" VerticalContentAlignment="Center"/>
			<local:CustomButton x:Name="CloseButton" IsFocusable="False" Grid.Row="0" Foreground="White" HorizontalAlignment="Right" Width="50" FontSize="12" Icon="{StaticResource XIconGeometry}" BackColor="#78FF0000"/>
			<Border Grid.Row="1" BorderThickness="1,0,1,1" BorderBrush="#A22A60">
				<Grid RowDefinitions="*,Auto">
					<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Foreground="White" FontSize="16" Margin="10,5,10,10">
						<StackPanel>
							<Label Content="Launcher scaling:"/>
							<Grid ColumnDefinitions="Auto,Auto,Auto" Margin="5" HorizontalAlignment="Center">
								<NumericUpDown x:Name="LauncherScalingUpDown" Minimum="50" Maximum="200" Value="100" Increment="1" Margin="0,0,10,0" FormatString="0'%'" Foreground="White" Background="#5DBC00A3"/>
								<local:CustomButton x:Name="LauncherScalingResetButton" Grid.Column="1" Icon="{StaticResource ArrowsRotateIconGeometry}" Margin="0,0,5,0" ButtonPadding="7"/>
								<local:CustomButton x:Name="LauncherScalingHelpButton" Grid.Column="2" Icon="{StaticResource QuestionIconGeometry}" ButtonPadding="7"/>
							</Grid>
							<Border BorderThickness="1,0,1,1" BorderBrush="#A22A60" Opacity="0.4" Margin="0,5,0,5"/>
							<Label Content="Client rendering:"/>
							<Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="5" HorizontalAlignment="Center">
								<local:CustomButton x:Name="ClientAirVersionButton" Grid.Column="0" Margin="0,0,5,0" Text="AIR: 51" ButtonPadding="7,4,7,5"/>
								<local:CustomButton x:Name="ClientRenderModeButton" Grid.Column="1" Margin="0,0,5,0" Text="Mode: CPU" ButtonPadding="7,4,7,5"/>
								<local:CustomButton x:Name="ClientResolutionButton" Grid.Column="2" Margin="0,0,10,0" Text="Resolution: Standard" ButtonPadding="7,4,7,5"/>
								<local:CustomButton x:Name="ClientRenderResetButton" Grid.Column="3" Margin="0,0,5,0" Icon="{StaticResource ArrowsRotateIconGeometry}" ButtonPadding="7"/>
								<local:CustomButton x:Name="ClientRenderHelpButton" Grid.Column="4" Icon="{StaticResource QuestionIconGeometry}" ButtonPadding="7"/>
							</Grid>
							<Border BorderThickness="1,0,1,1" BorderBrush="#A22A60" Opacity="0.4" Margin="0,5,0,5"/>
							<Label Content="More settings coming soon!" FontSize="25" HorizontalAlignment="Center"/>
						</StackPanel>
					</ScrollViewer>
					<local:CustomButton x:Name="OkButton" Grid.Row="1" Text="OK" Margin="10,5,10,10" ButtonPadding="7,4,7,5"/>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</Window>